{
  "framework": "nextjs",
  "buildCommand": "next build",
  "functions": {
    "app/[keyword]/page.tsx": {
      "maxDuration": 30,
      "memory": 1024
    },
    "src/app/api/**/*.ts": {
      "maxDuration": 300,
      "memory": 512
    },
    "src/app/api/humanizer/stream/route.ts": {
      "maxDuration": 600,
      "memory": 2048
    },
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 60,
      "memory": 512
    }
  }
}
