{
  "framework": "nextjs",
  "buildCommand": "next build",
  "functions": {
    "app/[keyword]/page.tsx": {
      "maxDuration": 10,
      "memory": 1024
    },
    "src/app/api/**/*.ts": {
      "maxDuration": 15
    },
    "src/app/api/humanizer/stream/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 60
    }
  }
}
