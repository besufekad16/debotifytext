{
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "functions": {
    "app/[keyword]/page.tsx": {
      "maxDuration": 10,
      "memory": 1024
    }
  },
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  }
}
