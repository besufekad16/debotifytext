{
  "name": "debotifytext",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env SKIP_ENV_VALIDATION=1 NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 next build",
    "seo:verify-pages": "npx tsx scripts/verify-sitemap-pages.ts",
    "seo:verify-http": "npx tsx scripts/http-check-pseo.ts",
    "check": "next lint && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev": "cross-env SKIP_ENV_VALIDATION=1 PORT=3050 next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "seo:generate-sitemaps": "npx tsx scripts/generate-all-sitemaps.ts",
    "seo:verify-links": "npx tsx scripts/verify-internal-links.ts",
    "seo:audit-uniqueness": "npx tsx scripts/audit-content-uniqueness.ts",
    "seo:submit-sitemap": "npx tsx seo/search-console-submitter.ts",
    "seo:full-deploy": "npm run seo:generate-sitemaps && npm run build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.34.4",
    "@google/genai": "^1.38.0",
    "@imagekit/next": "^2.1.3",
    "@polar-sh/sdk": "^0.34.16",
    "@prisma/client": "^6.5.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@t3-oss/env-nextjs": "^0.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compromise": "^14.14.4",
    "compromise-sentences": "^0.3.0",
    "framer-motion": "^12.23.24",
    "geist": "^1.5.1",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.543.0",
    "mammoth": "^1.11.0",
    "natural": "^8.1.0",
    "next": "15.5.9",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.4.394",
    "prisma": "^6.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "resend": "^6.5.2",
    "sonner": "^2.0.7",
    "svix": "^1.80.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "csv-parse": "^7.0.2",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "postcss": "^8.4.49",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "packageManager": "npm@11.0.0"
}
